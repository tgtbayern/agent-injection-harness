# Copy to .env and fill in. .env and *.db are git-ignored: never commit either.
#
# The harness reads these only as a fallback. The dashboard's config page stores
# providers in SQLite instead, which is the better path when more than one token
# is in play -- a gateway usually binds a token to a channel group, and a model
# outside that group fails with "no available channel".

# Base URL of an OpenAI-compatible gateway. It almost always has to end in /v1.
LLM_BASE_URL=https://api.example.com/v1

# Gateway token, including the sk- prefix. Copy it whole.
LLM_API_KEY=sk-replace-me

# Where the dashboard keeps providers, models, games and experiments.
WEREWOLF_DB=werewolf_harness.db

# Optional: mirror every model call to Langfuse. Without these the harness still
# writes its own JSONL spans, so tracing is never a hard dependency.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
